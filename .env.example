# ============================================================
# Configuration STARNÉT AFRIC — copiez ce fichier vers ".env"
# puis remplissez vos valeurs réelles. Ne commitez JAMAIS ".env".
# ============================================================

# --- Serveur ---
PORT=3000
NODE_ENV=development          # production en ligne (active cookies Secure, etc.)

# --- Compte administrateur (créé au premier démarrage) ---
ADMIN_USER=admin
ADMIN_PASSWORD=admin123        # >>> CHANGEZ-MOI <<< (mdp par défaut)

# --- Coordonnées affichées sur le site ---
SITE_EMAIL=support@starnetafric.com
SITE_PHONE=+243 000 000 000
SITE_WHATSAPP=243900000000
SITE_ADDRESS=Kinshasa, RD Congo

# --- Notifications Telegram (bot propriétaire @starnettellbot) ---
# 1. Créez/obtenez un token depuis @BotFather, puis envoyez « /start » à votre bot.
# 2. Renseignez ici, ou dans l'admin (Paramètres → Notifications Telegram → Détecter).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paiements mobile money (API officielles opérateur) ---
# Régime : TEST (aucun appel réseau, validation manuelle dans l'admin)
#      ou LIVE (appels vers les passerelles officielles une fois vos comptes marchands obtenus)
PAYMENT_MODE=TEST
PAYMENT_BASE_URL=http://localhost:3000

# Moov Money Africa (région opérateur)
MOOV_API_URL=
MOOV_MERCHANT_ID=
MOOV_API_KEY=
MOOV_WEBHOOK_SECRET=

# Orange Money (région opérateur)
ORANGE_API_URL=
ORANGE_MERCHANT_ID=
ORANGE_API_KEY=
ORANGE_WEBHOOK_SECRET=

# Airtel Money (région opérateur)
AIRTEL_API_URL=
AIRTEL_MERCHANT_ID=
AIRTEL_API_KEY=
AIRTEL_WEBHOOK_SECRET=

# MTN Mobile Money (région opérateur)
MTN_API_URL=
MTN_MERCHANT_ID=
MTN_MERCHANT_CODE=
MTN_API_KEY=
MTN_WEBHOOK_SECRET=

# Vodacom M-Pesa (région opérateur)
MPESA_API_URL=
MPESA_MERCHANT_ID=
MPESA_API_KEY=
MPESA_WEBHOOK_SECRET=