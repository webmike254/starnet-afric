{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/__r3.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/__r3.js" },
    { "src": "/", "dest": "public/forfaits.html" },
    { "src": "/index.html", "dest": "public/forfaits.html" },
    { "src": "/index", "dest": "public/forfaits.html" },
    { "src": "/forfaits.html", "dest": "public/forfaits.html" },
    { "src": "/forfaits", "dest": "public/forfaits.html" },
    { "src": "/network-status.html", "dest": "public/network-status.html" },
    { "src": "/network-status", "dest": "public/network-status.html" },
    { "src": "/statut.html", "dest": "public/network-status.html" },
    { "src": "/statut", "dest": "public/network-status.html" },
    { "src": "/commandes.html", "dest": "public/commandes.html" },
    { "src": "/commandes", "dest": "public/commandes.html" },
    { "src": "/contact.html", "dest": "public/contact.html" },
    { "src": "/contact", "dest": "public/contact.html" },
    { "src": "/verify-payment.html", "dest": "public/verify-payment.html" },
    { "src": "/verify-payment", "dest": "public/verify-payment.html" },
    { "src": "/admin/?", "dest": "public/admin/index.html" },
    { "src": "/admin/login.html", "dest": "public/admin/login.html" },
    { "src": "/admin/(.*)", "dest": "public/admin/$1" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
