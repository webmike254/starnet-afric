{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/__r3.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/__r3.js" },
    { "src": "/", "dest": "public/network-status.html" },
    { "src": "/index.html", "dest": "public/network-status.html" },
    { "src": "/index", "dest": "public/network-status.html" },
    { "src": "/statut.html", "dest": "public/network-status.html" },
    { "src": "/statut", "dest": "public/network-status.html" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "cleanUrls": true
}
