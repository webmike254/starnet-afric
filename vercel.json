{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/__r3.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/forfaits.html", "status": 301 },
    { "src": "/api/(.*)", "dest": "api/__r3.js" },
    { "src": "/(.*)", "dest": "public/$1" }
  ],
  "cleanUrls": true
}