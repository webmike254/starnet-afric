{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/__r3.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/__r3.js" },
    { "src": "/", "dest": "/forfaits.html" },
    { "src": "/index", "dest": "/forfaits.html" },
    { "src": "/index.html", "dest": "/forfaits.html" },
    { "src": "/statut", "dest": "/network-status.html" },
    { "src": "/statut.html", "dest": "/network-status.html" },
    { "src": "/network-status", "dest": "/network-status.html" },
    { "src": "/forfaits", "dest": "/forfaits.html" },
    { "src": "/commandes", "dest": "/commandes.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/verify-payment", "dest": "/verify-payment.html" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/admin/", "dest": "/admin/index.html" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
